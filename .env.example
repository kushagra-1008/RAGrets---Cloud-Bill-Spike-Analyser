# Path to the active billing database. Reset clears its active bill tables.
RAGRETS_DATABASE_PATH=ragrets.db
# Comma-separated trusted HTTPS domains for Agentverse PDF attachments.
RAGRETS_ATTACHMENT_ALLOWED_HOSTS=res.cloudinary.com

# Select "asi1" or "groq". ASI:One settings take precedence when selected.
RAGRETS_LLM_PROVIDER=asi1
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini
# Optional generic aliases and legacy Groq configuration.
RAGRETS_LLM_API_KEY=
RAGRETS_LLM_MODEL=
RAGRETS_GROQ_API_KEY=
RAGRETS_GROQ_MODEL=openai/gpt-oss-20b
RAGRETS_DASHBOARD_URL=

# Mailbox-based Agentverse / ASI:One agent settings.
AGENT_SEED_PHRASE=
AGENTVERSE_KEY=
RAGRETS_AGENT_NAME=ragrets-billing-agent
RAGRETS_AGENT_PORT=8000
RAGRETS_AGENT_ENDPOINT=
